<main>
  <section>
    <ul>
      {
        posts.map((post) => (
          <li>
            <a href={`/blog/${post.slug}/`}>
              <h4 class="title">{post.data.title}</h4>
              <p class="date">{post.data.pubDate}</p>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</main>
